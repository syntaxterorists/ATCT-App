<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATCT_Frontend.Views.VenuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ATCT_Frontend.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="backgroundgeometric">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <StackLayout Padding="16" Spacing="24">

                <!-- Header -->
                <StackLayout Orientation="Horizontal" Spacing="8">
                    <Image Source="atctlogocolorful" HeightRequest="120" HorizontalOptions="Start" />
                    <BoxView Color="#EF941F" HeightRequest="4" WidthRequest="60" VerticalOptions="End" />
                </StackLayout>

                <Label Text="ATCT Venues" FontFamily="JosefinSans" FontSize="24" FontAttributes="Bold" TextColor="Black" />

                <!-- Venue 1 -->
                <Label x:Name="Venue1Name" FontFamily="JosefinSans" FontSize="22" FontAttributes="Bold" TextColor="Black" />
                <Image x:Name="Venue1Image" Aspect="AspectFill" HeightRequest="200" />
                <Label x:Name="Venue1Desc" FontFamily="JosefinSans" FontSize="14" TextColor="Black" LineBreakMode="WordWrap" />

                <!-- Venue 2 -->
                <Label x:Name="Venue2Name" FontFamily="JosefinSans" FontSize="22" FontAttributes="Bold" TextColor="Black" />
                <Image x:Name="Venue2Image" Aspect="AspectFill" HeightRequest="200" />
                <Label x:Name="Venue2Desc" FontFamily="JosefinSans" FontSize="14" TextColor="Black" LineBreakMode="WordWrap" />

            </StackLayout>
        </ScrollView>

        <!-- Bottom nav bar -->
        <views:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
