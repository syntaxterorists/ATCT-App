<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATCT_Frontend.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
    shell:Shell.NavBarIsVisible="False">

    <!-- 1) Radial gradient background -->
    <ContentPage.Background>
        <RadialGradientBrush Center="0,0" Radius="1">
            <GradientStop Color="#FCA028" Offset="0.24" />
            <GradientStop Color="#C46F00" Offset="0.44" />
            <GradientStop Color="#181646" Offset="0.84" />
            <GradientStop Color="#02002B" Offset="0.97" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- back arrow -->
            <RowDefinition Height="Auto"/>
            <!-- logo -->
            <RowDefinition Height="Auto"/>
            <!-- title -->
            <RowDefinition Height="Auto"/>
            <!-- subtitle -->
            <RowDefinition Height="Auto"/>
            <!-- name field -->
            <RowDefinition Height="Auto"/>
            <!-- e-mail field -->
            <RowDefinition Height="Auto"/>
            <!-- password field -->
            <RowDefinition Height="Auto"/>
            <!-- register button -->
            <RowDefinition Height="*"   />
            <!-- filler -->
            <RowDefinition Height="Auto"/>
            <!-- info icon -->
        </Grid.RowDefinitions>

        <!-- top space iamge -->

        <Image Source="spacetwo.png"
 Aspect="Fill"
 HeightRequest="140"
 WidthRequest="385"
 HorizontalOptions="Start"
 VerticalOptions="Start"
 Margin="0,-3,10,0"
 Grid.Row="0"/>
        <!-- 1) Back arrow -->
        <Image
      Grid.Row="0"
      Source="arrowicon"
      HeightRequest="32"
      WidthRequest="32"
      Margin="20,50,0,0"
      HorizontalOptions="Start"
      VerticalOptions="Start">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped" />
            </Image.GestureRecognizers>
        </Image>

        <!-- 2) ATCT logo -->
        <Image
      Grid.Row="1"
      Source="atctlogowhite"
      HeightRequest="80"
      WidthRequest="150"
      Margin="0,-30,0,8"
      HorizontalOptions="Center" />

        <!-- 3) Page title -->
        <Label
      Grid.Row="2"
      Text="Register"
      FontFamily="JosefinSans"
      FontSize="28"
      FontAttributes="Bold"
      TextColor="White"
      HorizontalOptions="Center" />

        <!-- 4) Subtitle -->
        <Label
      Grid.Row="3"
      Text="Don’t have an account? Create one!"
      FontFamily="JosefinSans"
      FontSize="16"
      TextColor="White"
      HorizontalOptions="Center"
      Margin="0,4,0,20" />

        <!-- 5) Name field -->
        <StackLayout
      Grid.Row="4"
      Spacing="5"
      Padding="30,0">
            <Label
        Text="Name:"
        FontFamily="JosefinSans"
                FontAttributes="Bold"
                FontSize="16"
        TextColor="White" />
            <Frame
        BackgroundColor="#F8F3F3"
        CornerRadius="50"
        HasShadow="False"
        Padding="10">
                <Entry
          Text="{Binding Name}"
          Placeholder="John Doe"
          TextColor="Black"
          BackgroundColor="Transparent" />
            </Frame>
        </StackLayout>



        <!-- 6) E-mail field -->
        <StackLayout
      Grid.Row="5"
      Spacing="5"
      Padding="30,10,30,0">
            <Label
        Text="E-mail:"
        FontFamily="JosefinSans"
            FontAttributes="Bold"
            FontSize="16"
        TextColor="White" />
            <Frame
        BackgroundColor="#F8F3F3"
        CornerRadius="50"
        HasShadow="False"
        Padding="10">
                <Entry
          Text="{Binding Email}"
          Placeholder="johndoe@outlook.com"
          Keyboard="Email"
          TextColor="Black"
          BackgroundColor="Transparent" />
            </Frame>
        </StackLayout>

        <!-- 7) Password field -->
        <StackLayout
      Grid.Row="6"
      Spacing="5"
      Padding="30,10,30,0">
            <Label
        Text="Password:"
        FontFamily="JosefinSans"
           FontAttributes="Bold"
            FontSize="16"
        TextColor="White" />
            <Frame
        BackgroundColor="#F8F3F3"
        CornerRadius="50"
        HasShadow="False"
        Padding="10">
                <Entry
          Text="{Binding Password}"
          Placeholder="********"
          IsPassword="True"
          TextColor="Black"
          BackgroundColor="Transparent" />
            </Frame>
        </StackLayout>

        <!-- 8) Register button -->
        <Button
      Grid.Row="7"
      Text="Register"
            FontSize="18"
            BorderWidth="3"
      Style="{StaticResource OutlineButtonStyle}"
      FontAttributes="Bold"
      Clicked="OnRegisterClicked"
      Margin="30,25" />

        <!-- 9) Info icon -->
        <Image
      Grid.Row="9"
      Source="information"
      HeightRequest="24"
      WidthRequest="24"
      HorizontalOptions="Center"
      Margin="0,0,0,24" />
    </Grid>
</ContentPage>
