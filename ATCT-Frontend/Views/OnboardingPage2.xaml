<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
             x:Class="ATCT_Frontend.Views.OnboardingPage2"
             shell:Shell.NavBarIsVisible="False">

    <!-- Radial background from #181646 to #FC9918 -->
    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.3" Radius="1">
            <GradientStop Color="#181646" Offset="0"/>
            <GradientStop Color="#FC9918" Offset="1"/>
        </RadialGradientBrush>
    </ContentPage.Background>

    <!-- Center content shifted upward -->
    <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Start" HorizontalOptions="Center">

        <!-- Top logo + year -->
        <Grid HorizontalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Source="atctlogowhite.png"
                   Grid.Row="0"
                   WidthRequest="340"
                   HeightRequest="106"
                   Aspect="AspectFit" 
                   Margin="-10,20,0,0"/>
            <Image Source="year.png"
                   Grid.Row="1"
                   WidthRequest="80"
                   HeightRequest="80"
                   HorizontalOptions="End"
                   Margin="-10,-40,15,0"
                   Aspect="AspectFit" />
        </Grid>

        <!-- Main illustration -->
        <Frame CornerRadius="20" HasShadow="False" Padding="0" Margin="0,10,0,0" WidthRequest="300" HeightRequest="200">
            <Image Source="crowdtwo.png" Aspect="AspectFill" />
        </Frame>

        <!-- Description text -->
        <Label Text="This conference will bring together professionals, experts, and innovative communities from Bosnia and Herzegovina, the region, and Europe. They will explore digital solutions to develop innovative projects, products, and services."
               FontFamily="JosefinSans"
               FontAttributes="Bold"
               FontSize="18"
               TextColor="White"
               HorizontalTextAlignment="Center"
               LineHeight="1.4"
               Margin="0,10,0,0" />

        <!-- Page indicators (second filled) -->
        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,15,0,0">
            <Image Source="opencircle.png" WidthRequest="12" HeightRequest="12" />
            <Image Source="filledcircle.png" WidthRequest="15" HeightRequest="15" />
            <Image Source="opencircle.png" WidthRequest="12" HeightRequest="12" />
            <Image Source="opencircle.png" WidthRequest="12" HeightRequest="12" />
        </HorizontalStackLayout>

        <!-- Next button -->
        <Button Text="Next"
         FontFamily="JosefinSans"
         FontAttributes="Bold"
         BackgroundColor="#FC9918"
         TextColor="black"
         CornerRadius="5"
         FontSize="18"
         Padding="12"
         WidthRequest="200"
         HorizontalOptions="Center"
         Margin="0,0,0,0"
         Clicked="OnNextClicked"/>

        <!-- Back arrow below button -->
        <Image Source="arrowicon.png"
               WidthRequest="24"
               HeightRequest="24"
               HorizontalOptions="Start"
               Margin="10,0,0,0">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped"/>
            </Image.GestureRecognizers>
        </Image>

    </VerticalStackLayout>
</ContentPage>