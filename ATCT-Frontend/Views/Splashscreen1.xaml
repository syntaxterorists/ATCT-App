<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
             x:Class="ATCT_Frontend.Views.Splashscreen1"
             shell:Shell.NavBarIsVisible="False">


    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f79009" Offset="0.0"/>
            <GradientStop Color="#1e0059" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*,Auto,*">

        <!-- Top decorative image -->
        <Image Source="spacetwo.png"
               Aspect="Fill"
               HeightRequest="156"
               WidthRequest="385"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Margin="0,-3,10,0"
               Grid.Row="0"/>

        <!-- Bottom decorative image -->
        <Image Source="spaceone.png"
       Aspect="Fill"
       HeightRequest="146"
       WidthRequest="400"
       HorizontalOptions="End"
       VerticalOptions="End"
       Grid.Row="2"/>
        <!-- Main content -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="30"
                             Spacing="10"
                             Margin="0,0,0,0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center">

            <!-- ATCT + 2025 as one unit -->
            <Grid WidthRequest="250" HorizontalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ATCT logo -->
                <Image Source="atctlogowhite.png"
                       Grid.Row="0"
                       Aspect="Fill"
                       WidthRequest="340"
                       HeightRequest="106"
                       Margin="0,40,0,100"
                       HorizontalOptions="Center"/>

                <!-- 2025 logo under it -->
                <Image Source="year.png"
                       Grid.Row="1"
                       WidthRequest="80"
                       HeightRequest="70"
                       HorizontalOptions="End"
                       Margin="0,-220,-30,0"/>
            </Grid>

            <!-- Subtitle -->
            <Label Text="International&#10;Conference on&#10;Advances in&#10;Traffic and&#10;Communication&#10;Technologies"
                   FontSize="35"
                   TextColor="White"
                   FontFamily="OcrAExtended"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.3"
                   Margin="0,-60,0,20"/>

            <!-- Icons -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15" Margin="0,10,0,10">
                <Image Source="caricon.png" WidthRequest="40" HeightRequest="40"/>
                <Image Source="planeicon.png" WidthRequest="40" HeightRequest="40"/>
                <Image Source="wifiicon.png" WidthRequest="40" HeightRequest="40"/>
            </HorizontalStackLayout>

            <!-- Button -->
            <Button Text="Get started"
                    BackgroundColor="#FFA500"
                    TextColor="Black"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="5"
                    Padding="20"
                    HorizontalOptions="Center"
                    Margin="0,10,0,-50"
                    WidthRequest="250"
                    Clicked="OnGetStartedClicked"/>
        </VerticalStackLayout>




    </Grid>
</ContentPage>
