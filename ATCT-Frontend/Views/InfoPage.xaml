<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATCT_Frontend.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ATCT_Frontend.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="backgroundgeometric">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0">
            <StackLayout Padding="16" Spacing="20">

                <!-- ATCT logo -->
                <Image
          Source="atctlogocolorful"
          HeightRequest="120"
          HorizontalOptions="Center" />

                <!-- About tile -->
                <Frame
          CornerRadius="12"
          HasShadow="False"
          Padding="0"
          Margin="0,8,0,0">
                    <Image
            Source="aboutfield"
            Aspect="AspectFill"
            HeightRequest="150"
            HorizontalOptions="FillAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAboutTapped" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>

                <!-- Program tile -->
                <Frame
          CornerRadius="12"
          HasShadow="False"
          Padding="0"
          Margin="0,8,0,0">
                    <Image
            Source="programfield"
            Aspect="AspectFill"
            HeightRequest="150"
            HorizontalOptions="FillAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProgramTapped" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>

                <!-- Speakers tile -->
                <Frame
          CornerRadius="12"
          HasShadow="False"
          Padding="0"
          Margin="0,8,0,0">
                    <Image
            Source="speakersfield"
            Aspect="AspectFill"
            HeightRequest="150"
            HorizontalOptions="FillAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSpeakersTapped" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Bottom nav bar pinned -->
        <views:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>
