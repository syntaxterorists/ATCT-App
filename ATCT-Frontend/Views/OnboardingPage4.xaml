<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
             x:Class="ATCT_Frontend.Views.OnboardingPage4"
             shell:Shell.NavBarIsVisible="False">

    <!-- Radial background from #181646 to #FC9918 -->
    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.3" Radius="1">
            <GradientStop Color="#181646" Offset="0"/>
            <GradientStop Color="#FC9918" Offset="1"/>
        </RadialGradientBrush>
    </ContentPage.Background>

    <!-- Center content shifted upward -->
    <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Start" HorizontalOptions="Center">

        <!-- Top logo + year -->
        <Grid HorizontalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Source="atctlogowhite.png"
            Grid.Row="0"
            WidthRequest="340"
            HeightRequest="106"
            Aspect="AspectFit" 
            Margin="-10,20,0,0"/>
            <Image Source="year.png"
            Grid.Row="1"
            WidthRequest="80"
            HeightRequest="80"
            HorizontalOptions="End"
            Margin="-10,-40,15,0"
            Aspect="AspectFit" />
        </Grid>

        <!-- (Frame and description removed for Page 3) -->

        <!-- Sponsored by section -->
        <Label Text="Sponsored by:" 
               FontFamily="JosefinSans"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Start"
               Margin="0,0,0,0" />
        <FlexLayout Wrap="Wrap"
                    JustifyContent="Center"
                    AlignItems="Center"
                    Margin="0,30,0,0">
            <Image Source="logobhansa.png" HeightRequest="50" Aspect="AspectFit" Margin="0,0,0,0"/>
            <Image Source="logobhposta.png" HeightRequest="50" Aspect="AspectFit" Margin="0,0,0,0"/>
            <Image Source="logobhtelecom.png" HeightRequest="50" Aspect="AspectFit" Margin="0,10,20,0"/>
            <Image Source="logobrzaposta.png" HeightRequest="50" Aspect="AspectFit" Margin="0,0,0,0"/>
            <Image Source="logobstelecom.png" HeightRequest="50" Aspect="AspectFit" Margin="0,20,0,0"/>
            <Image Source="logoeuroasfalt.png" HeightRequest="50" Aspect="AspectFit" Margin="0,0,0,0"/>
            <Image Source="logoporsche.png" HeightRequest="50" Aspect="AspectFit" Margin="0,10,0,-5"/>
            <Image Source="logoppg.png" HeightRequest="50" Aspect="AspectFit" Margin="0,0,0,0"/>
            <Image Source="logosarajevo.png" HeightRequest="50" Aspect="AspectFit" Margin="0,10,0,0"/>
        </FlexLayout>

        <!-- Page indicators (fourth filled) -->
        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,0">
            <Image Source="opencircle.png" WidthRequest="12" HeightRequest="12" />
            <Image Source="opencircle.png" WidthRequest="12" HeightRequest="12" />
            <Image Source="opencircle.png" WidthRequest="12" HeightRequest="12" />
            <Image Source="filledcircle.png" WidthRequest="15" HeightRequest="15" />
        </HorizontalStackLayout>

        <!-- Next button -->
        <Button Text="Proceed"
                FontFamily="JosefinSans"
                BackgroundColor="#FC9918"
                TextColor="Black"
                FontAttributes="Bold"
                CornerRadius="5"
                FontSize="18"
                Padding="12"
                WidthRequest="200"
                HorizontalOptions="Center"
                Margin="0,0,0,0"
                Clicked="OnNextClicked"/>

        <!-- Back arrow below button -->
        <Image Source="arrowicon.png"
               WidthRequest="24"
               HeightRequest="24"
               HorizontalOptions="Start"
               Margin="10,0,0,0">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackTapped"/>
            </Image.GestureRecognizers>
        </Image>

    </VerticalStackLayout>
</ContentPage>