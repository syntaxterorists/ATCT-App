<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ATCT_Frontend.Views.BottomNavBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="60"
    VerticalOptions="End">

    <Grid
    BackgroundColor="#E08714"
    ColumnDefinitions="*,*,*,*">

        <!-- Home -->
        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
            <Image Source="iconhome" HeightRequest="24" WidthRequest="24" />
            <Label Text="Home" FontFamily="JosefinSans" FontSize="12" TextColor="White" />
        </VerticalStackLayout>

        <!-- Venues -->
        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
            <Image Source="iconlocation" HeightRequest="24" WidthRequest="24" />
            <Label Text="Venues" FontFamily="JosefinSans" FontSize="12" TextColor="White" />
        </VerticalStackLayout>

        <!-- Info -->
        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
            <Image Source="iconquestionmark" HeightRequest="24" WidthRequest="24" />
            <Label Text="Info" FontFamily="JosefinSans" FontSize="12" TextColor="White" />
        </VerticalStackLayout>

        <!-- Profile -->
        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
            <Image Source="iconprofile" HeightRequest="24" WidthRequest="24" />
            <Label Text="Profile" FontFamily="JosefinSans" FontSize="12" TextColor="White" />
        </VerticalStackLayout>

    </Grid>
</ContentView>
