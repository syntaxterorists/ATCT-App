<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATCT_Frontend.Views.SpeakersAltPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ATCT_Frontend.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="backgroundgeometric">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with back arrow + title -->
        <HorizontalStackLayout
      Grid.Row="0"
      Padding="16,16,16,0"
      Spacing="16"
      VerticalOptions="Start">

            <Image
        Source="arrowicon"
        HeightRequest="32"
        WidthRequest="32">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>

            <VerticalStackLayout Spacing="4">
                <Label
          Text="Speakers"
          FontFamily="JosefinSans"
          FontSize="24"
          FontAttributes="Bold"
          TextColor="Black" />
                <BoxView
          Color="#FCA028"
          HeightRequest="4"
          WidthRequest="60"
          HorizontalOptions="Start" />
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <!-- Scrollable list of speakers -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="16" Spacing="16">

                <!-- Repeat this block for each speaker -->
                <Grid ColumnDefinitions="Auto, *" RowSpacing="8" Padding="0">
                    <!-- Photo -->
                    <Image
            Source="kemalmalovcic"
            HeightRequest="80"
            WidthRequest="80"
            Aspect="AspectFill"
            VerticalOptions="Center" />

                    <!-- Info box -->
                    <Frame
            Grid.Column="1"
            CornerRadius="12"
            BackgroundColor="#FCA028"
            HasShadow="False"
            Padding="12"
            VerticalOptions="Center">
                        <StackLayout Spacing="4">
                            <Label
                Text="Kemal Malovčić"
                FontFamily="JosefinSans"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="White" />
                            <Label
                Text="Dipl. in. tezga i kafana, svjetski prvak u pogađanju oktava"
                FontFamily="JosefinSans"
                FontSize="14"
                TextColor="White"
                LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <!-- Copy above Grid 3 more times (or bind to a collection for real data) -->
                <!-- ... -->
                <Grid ColumnDefinitions="Auto, *" RowSpacing="8" Padding="0">
                    <Image Source="kemalmalovcic" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" VerticalOptions="Center" />
                    <Frame Grid.Column="1" CornerRadius="12" BackgroundColor="#FCA028" HasShadow="False" Padding="12" VerticalOptions="Center">
                        <StackLayout Spacing="4">
                            <Label Text="Kemal Malovčić" FontFamily="JosefinSans" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Dipl. in. tezga i kafana, svjetski prvak u pogađanju oktava" FontFamily="JosefinSans" FontSize="14" TextColor="White" LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <Grid ColumnDefinitions="Auto, *" RowSpacing="8" Padding="0">
                    <Image Source="kemalmalovcic" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" VerticalOptions="Center" />
                    <Frame Grid.Column="1" CornerRadius="12" BackgroundColor="#FCA028" HasShadow="False" Padding="12" VerticalOptions="Center">
                        <StackLayout Spacing="4">
                            <Label Text="Kemal Malovčić" FontFamily="JosefinSans" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Dipl. in. tezga i kafana, svjetski prvak u pogađanju oktava" FontFamily="JosefinSans" FontSize="14" TextColor="White" LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <Grid ColumnDefinitions="Auto, *" RowSpacing="8" Padding="0">
                    <Image Source="kemalmalovcic" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" VerticalOptions="Center" />
                    <Frame Grid.Column="1" CornerRadius="12" BackgroundColor="#FCA028" HasShadow="False" Padding="12" VerticalOptions="Center">
                        <StackLayout Spacing="4">
                            <Label Text="Kemal Malovčić" FontFamily="JosefinSans" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Dipl. in. tezga i kafana, svjetski prvak u pogađanju oktava" FontFamily="JosefinSans" FontSize="14" TextColor="White" LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>
                </Grid>

            </StackLayout>
        </ScrollView>

        <!-- Bottom nav bar pinned -->
        <views:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>
