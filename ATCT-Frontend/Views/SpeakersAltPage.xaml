<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATCT_Frontend.Views.SpeakersAltPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ATCT_Frontend.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="backgroundgeometric">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HorizontalStackLayout
            Grid.Row="0"
            Padding="16,16,16,0"
            Spacing="16"
            VerticalOptions="Start">

            <Image
                Source="arrowicon"
                HeightRequest="32"
                WidthRequest="32">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Speakers"
                    FontFamily="JosefinSans"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="Black" />
                <BoxView
                    Color="#FCA028"
                    HeightRequest="4"
                    WidthRequest="60"
                    HorizontalOptions="Start" />
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <!-- List of speakers -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Speakers}"
            Margin="0,12,0,12"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Margin="16,8"
                        BackgroundColor="#FCA028"
                        CornerRadius="16"
                        Padding="12"
                        HasShadow="False">

                        <HorizontalStackLayout Spacing="16">
                            <!-- Speaker Image -->
                            <Frame
                                Padding="0"
                                CornerRadius="35"
                                HeightRequest="70"
                                WidthRequest="70"
                                IsClippedToBounds="True"
                                HasShadow="False"
                                BackgroundColor="White">
                                <Image
                                    Source="{Binding ImageUrl}"
                                    Aspect="AspectFill"
                                    HeightRequest="70"
                                    WidthRequest="70" />
                            </Frame>

                            <!-- Speaker Info -->
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding FullName}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    FontFamily="JosefinSans" />
                                <Label
                                    Text="{Binding Description}"
                                    FontSize="14"
                                    TextColor="White"
                                    FontFamily="JosefinSans"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom nav -->
        <views:BottomNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
