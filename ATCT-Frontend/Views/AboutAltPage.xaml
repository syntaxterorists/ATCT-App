<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATCT_Frontend.Views.AboutAltPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ATCT_Frontend.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundImageSource="backgroundgeometric">

    <!-- 3 rows: title, content, bottom nav -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1) Header: “About” + orange underline -->
        <StackLayout
      Grid.Row="0"
      Padding="16,16,20,0"
      Spacing="0"
      HorizontalOptions="Start">

            <Label
        Text="About"
        FontFamily="JosefinSans"
        FontSize="30"
        FontAttributes="Bold"
        TextColor="Black" />
            <BoxView
        Color="#FCA028"
        HeightRequest="5"
        WidthRequest="80"
        HorizontalOptions="Start" />
        </StackLayout>

        <!-- 2) Scrollable body -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20" Spacing="0">

                <!-- ATCT heading + blue underline -->
                <Label
          Text="ATCT"
          FontFamily="JosefinSans"
          FontSize="28"
          FontAttributes="Bold"
          TextColor="Black"
          HorizontalOptions="Start" />
                <BoxView
          Color="#1E90FF"
          HeightRequest="5"
          WidthRequest="70"
          HorizontalOptions="Start" />

                <!-- Orange question heading -->
                <Label
          Text="What does ATCT give to the people?"
                    Margin="0,20"
          FontFamily="JosefinSans"
          FontSize="25"
          FontAttributes="Bold"
          TextColor="#FCA028"
          HorizontalOptions="Start" />

                <!-- Body text paragraphs -->
                <Label
          Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Proin feugiat semper ultricies. Donec interdum varius tellus, eget iaculis eros tempus eget. Morbi imperdiet justo turpis, at scelerisque eros tempor ut. Etiam porttitor metus quis nunc molestie porttitor vel in dolor. Nulla eget luctus massa, ac molestie ex."
          FontFamily="JosefinSans"
          FontSize="16"
          TextColor="Black"
          LineBreakMode="WordWrap" />

                <Label
          Text="Proin libero ipsum, tincidunt eget sapien varius, finibus pellentesque sapien. In id accumsan elit. Cras sit amet pellentesque nunc, rhoncus dapibus lorem. Proin vitae tortor, bibendum nec commodo quis, elementum maximus vitae nisi. Sed leo tellus, ullamcorper vitae tincidunt vel, gravida at odio. Sed dapibus orci sapien, et consectetur arcu blandit a. Nulla rutrum mauris vitae velit."
          FontFamily="JosefinSans"
          FontSize="16"
          TextColor="Black"
          LineBreakMode="WordWrap" />

            </StackLayout>
        </ScrollView>

        <!-- 3) Bottom nav bar -->
        <views:BottomNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
